<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow Layer (Offset to bottom-right) -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#1A1A2E" /> <!-- Shadow color -->
        </shape>
    </item>

    <!-- Keycap Outline and Fill Layer (Padded on bottom-right to fit shadow) -->
    <item
        android:id="@+id/key_fill_layer"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#FFFFFF" /> <!-- Dynamic fill color -->
            <stroke
                android:width="3dp"
                android:color="#1A1A2E" /> <!-- Outline border color -->
        </shape>
    </item>
</layer-list>
